{
	"name": "theatlas-media",
	"engines": {
		"bun": ">=1.4.0"
	},
	"packageManager": "bun",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "bun --bun tauri dev",
		"build": "bun --bun tauri build",
		"icon": "bun --bun tauri icon src/assets/TheAtlasMediaW2048.png",
		"next:dev": "bun --bun next dev --turbopack",
		"next:build": "bun --bun next build",
		"next:start": "bun --bun next start",
		"lint": "bun --bun eslint",
		"tauri:dev": "bun --bun tauri dev",
		"tauri:build": "bun --bun icon && bun --bun tauri build",
		"build:linux": "bun --bun icon && bash scripts/build-linux.sh",
		"build:arch": "bash scripts/build-arch-pkg.sh"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/cli": "^2.11.4",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"class-variance-authority": "^0.7.1",
		"cli": "npm:@tauri-apps/cli@^2.11.4",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.4.2",
		"lucide-react": "^1.31.0",
		"next": "16.2.9",
		"next-themes": "^0.4.6",
		"postcss": "^8.5.26",
		"radix-ui": "^1.6.7",
		"react": "19.2.7",
		"react-day-picker": "^10.0.1",
		"react-dom": "19.2.7",
		"react-resizable-panels": "^4.12.2",
		"recharts": "3.8.1",
		"shadcn": "^4.16.2",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"tauri": "^0.15.0",
		"tw-animate-css": "^1.4.0",
		"vaul": "^1.1.2"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"eslint": "^9.39.5",
		"eslint-config-next": "16.2.9",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2"
	},
	"trustedDependencies": [
		"tauri",
		"unrs-resolver"
	]
}
