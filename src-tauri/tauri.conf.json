{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "TheAtlas Media",
	"version": "0.0.1",
	"identifier": "com.atlasata.theatlas-media",
	"build": {
		"frontendDist": "../out",
		"devUrl": "http://localhost:3000",
		"beforeDevCommand": "bun next --turbopack",
		"beforeBuildCommand": "bun run next:build"
	},
	"app": {
		"windows": [
			{
				"title": "TheAtlas — Media",
				"resizable": true,
				"decorations": false
			}
		],
		"security": {
			"dangerousDisableAssetCspModification": [
				"style-src"
			],
			"csp": {
				"default-src": [
					"'self'"
				],
				"script-src": [
					"'self'",
					"localhost:*"
				],
				"style-src": [
					"'self'",
					"'unsafe-inline'"
				],
				"img-src": [
					"'self'",
					"data:",
					"https:"
				],
				"media-src": [
					"'self'",
					"data:",
					"https:"
				],
				"font-src": [
					"'self'",
					"data:"
				],
				"connect-src": [
					"'self'",
					"ipc:",
					"http://ipc.localhost",
					"localhost:*",
					"ws://localhost:*",
					"wss://localhost:*"
				],
				"frame-src": [
					"'self'"
				],
				"object-src": [
					"'none'"
				],
				"base-uri": [
					"'self'"
				],
				"form-action": [
					"'self'"
				],
				"frame-ancestors": [
					"'none'"
				]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"android": {
			"debugApplicationIdSuffix": ".debug"
		},
		"copyright": "atlasatakahraman 2026",
		"license": "AAKNCL-1.0",
		"category": "GraphicsAndDesign",
		"homepage": "main",
		"publisher": "Atlas Ata KAHRAMAN",
		"licenseFile": "../LICENSE.md",
		"fileAssociations": [
			{
				"ext": [
					"tmp-video"
				],
				"mimeType": "video/mp4",
				"name": "Temporary Video File",
				"exportedType": {
					"identifier": "com.atlasata.tempvideo",
					"conformsTo": [
						"public.movie",
						"public.data"
					]
				},
				"role": "Viewer"
			},
			{
				"ext": [
					"tmp-audio"
				],
				"mimeType": "audio/m4a",
				"name": "Temporary Audio File",
				"exportedType": {
					"identifier": "com.atlasata.tempaudio",
					"conformsTo": [
						"public.audio",
						"public.data"
					]
				},
				"role": "Viewer"
			},
			{
				"ext": [
					"webm"
				],
				"mimeType": "video/webm",
				"name": "Temporary Video File",
				"exportedType": {
					"identifier": "com.atlasata.tempvideo",
					"conformsTo": [
						"public.movie",
						"public.data"
					]
				},
				"role": "Viewer"
			}
		],
		"resources": [
			"../src/assets/*"
		],
		"windows": {
			"allowDowngrades": true,
			"certificateThumbprint": null,
			"digestAlgorithm": "SHA-256",
			"minimumWebview2Version": null,
			"nsis": {
				"compression": "lzma",
				"displayLanguageSelector": true,
				"installerIcon": "./icons/icon.ico",
				"languages": [
					"Turkish",
					"English"
				],
				"startMenuFolder": "TheAtlas",
				"installMode": "currentUser"
			},
			"signCommand": null,
			"timestampUrl": null,
			"tsp": false,
			"webviewInstallMode": {
				"silent": true,
				"type": "embedBootstrapper"
			},
			"wix": {
				"enableElevatedUpdateTask": false,
				"language": "en-US"
			}
		}
	}
}
